# Supabase — Project Settings > API
# ทั้งสองค่านี้ปลอดภัยที่จะอยู่ฝั่ง client (anon key ถูกจำกัดสิทธิ์ด้วย RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ห้ามเพิ่ม SUPABASE_SERVICE_ROLE_KEY ที่นี่หรือที่ไหนก็ตามในโปรเจกต์นี้
# โปรเจกต์นี้ไม่ใช้ service_role key เลย แม้แต่ใน test harness

# ใช้เฉพาะตอนรัน acceptance tests (ไฟล์นี้ไม่ต้องมีค่าเหล่านี้บน Vercel)
PROD_URL=https://your-app.vercel.app
TEST_USER_A_EMAIL=usera@test.local
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=userb@test.local
TEST_USER_B_PASSWORD=
