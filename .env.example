# Supabase — Project Settings > API
# ทั้งสองค่านี้ปลอดภัยที่จะอยู่ฝั่ง client (ถูกจำกัดสิทธิ์ด้วย RLS อยู่แล้ว)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# ห้ามเพิ่ม SUPABASE_SERVICE_ROLE_KEY ที่นี่หรือที่ไหนก็ตามในโปรเจกต์นี้
# โปรเจกต์นี้ไม่ใช้ service_role key เลย แม้แต่ใน test harness

# ---------------------------------------------------------------------------
# ใช้เฉพาะตอนรัน acceptance tests — ไม่ต้องตั้งบน Vercel
# ---------------------------------------------------------------------------

# URL ที่จะทดสอบ (AT#11 ต้องเป็น production ไม่ใช่ localhost)
PROD_URL=https://your-app.vercel.app

# บัญชี admin สำหรับตรวจ role — แอปไม่มีทางให้เลื่อนตัวเองเป็น admin
# ผู้ดูแลต้องสร้างบัญชีแล้วเลื่อน role ด้วย SQL:
#   update profiles set role = 'admin' where email = '...';
# ถ้าเว้นว่าง ส่วน admin จะถูก SKIP ไม่ใช่ FAIL
ADMIN_EMAIL=
ADMIN_PASSWORD=
